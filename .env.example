# freecut — transcription backend configuration
#
# By default, freecut transcribes locally with Whisper (free, no key needed).
# The variables below are only required for optional backends.

# Optional: URL of a VibeVoice-ASR HTTP endpoint (rented GPU / Modal / RunPod
# / Azure AI Foundry). Enables multi-speaker diarization via
#   --backend vibevoice
# VIBEVOICE_ASR_URL=https://your-endpoint.example.com/transcribe

# Optional: Base URL of a FunASR OpenAI-compatible server. Enables
# multi-speaker diarization (CAM++) via
#   --backend funasr
# The value may be a bare host, a /v1 base, or the full transcriptions path;
# all are normalized to POST <url>/v1/audio/transcriptions.
# FUN_ASR_URL=http://192.168.50.79:5078

# Optional: ElevenLabs Scribe API key. Enables the paid legacy backend via
#   --backend elevenlabs
# ELEVENLABS_API_KEY=

# Optional: OmniVoice TTS narration. This is not a secret and is not required
# for the default workflow. Set one of the following, or put omnivoice-infer
# on PATH:
#   OMNIVOICE_HOME=/path/to/OmniVoice   # checkout whose .venv contains the CLI
#   OMNIVOICE_BIN=/path/to/omnivoice-infer
# OMNIVOICE_HOME=
# OMNIVOICE_BIN=
